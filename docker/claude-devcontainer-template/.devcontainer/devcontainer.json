{
  // ---------------------------------------------------------------------
  // Reusable Claude Code dev container template.
  // Copy this whole ".devcontainer" folder into the root of any new
  // project, then in Cursor: Cmd+Shift+P -> "Dev Containers: Reopen in Container"
  // ---------------------------------------------------------------------

  "name": "claude-code-project",

  // Base image + features are pulled/cached once by Docker (via OrbStack)
  // and reused for every project — nothing gets reinstalled per project.
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

  "features": {
    // Official Anthropic-maintained feature: installs Claude Code CLI
    // and keeps it updated. No manual npm install needed.
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},

    // Common tools most projects want: git, sudo, zsh, etc.
    "ghcr.io/devcontainers/features/common-utils:2": {},

    // Node.js — remove or change this block if a project doesn't need it,
    // or add other language features (python, go, etc.) per project.
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },

    // Miniconda — official feature, installs conda once per image build
    // (cached across projects, not reinstalled each time).
    "ghcr.io/devcontainers/features/conda:2": {
      "version": "latest",
      "addCondaForge": true
    }
  },

  // This is the only part that makes auth "just work" everywhere:
  // both files live on your Mac, outside any container, and are
  // bind-mounted (not copied) into every project's container.
  // First login anywhere writes here; every future container reads it.
  "mounts": [
    "source=${localEnv:HOME}/.claude-shared/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude-shared/.claude.json,target=/home/vscode/.claude.json,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached,readonly"
  ],

  "remoteUser": "vscode",

  // Optional: uncomment to stop Claude Code from auto-updating mid-session
  // "containerEnv": {
  //   "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  // },

  // Initializes conda for both shells so it's ready in every new terminal
  // without you having to run `conda init` yourself, then sanity-checks
  // Claude Code is present.
  "postCreateCommand": "conda init bash zsh && claude --version && conda --version"
}
